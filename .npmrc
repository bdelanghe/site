# npm v12 install-time security defaults (npm changelog, 2026-07-08).
#
# v12 turns three previously-automatic install behaviours off. Set here rather
# than as flags because 15 workflows run `npm ci`, and because a contributor's
# local install should behave exactly like CI — a policy that only exists in CI
# is a policy you discover in CI.
#
# allow-git=none
#   Was `root`, for exactly one dependency: @bdelanghe/brand had no registry
#   release, so it resolved from git. It is now @bdelanghe/brand@^0.1.0 from npm,
#   this repo resolves zero dependencies from git, and the setting that existed to
#   permit that one is retired — which is what "Retiring the brand git dep would
#   let this go to `none`" said would happen.
#
# allow-remote is deliberately left at v12's `none` default: this repo resolves
# zero dependencies from remote tarballs today, and that is worth keeping. (Not
# every repo can — site-mcp pulls four packages from npm.jsr.io by construction.)
#
# Install scripts are allowlisted per-package in package.json's `allowScripts`,
# kept exact against the lockfile by scripts/check-allow-scripts.mjs.
allow-git=none
